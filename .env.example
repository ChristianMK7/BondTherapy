# Copy to .env and fill in real values
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-string

# Admin credentials — also used to log in via the main site (username instead of email)
ADMIN_USER=admin
ADMIN_PASS=change-me-to-something-strong

# Set in production once you deploy with HTTPS
# NODE_ENV=production
# PUBLIC_URL=https://yourdomain.com

# Payment methods — shown to clients when paying for a booking
WHISH_NUMBER=+961 XX XXX XXX
WHISH_NAME=Your Name
OMT_NUMBER=+961 XX XXX XXX
OMT_NAME=Your Name

# Platform fee added on top of the therapist's session price (in %).
# Example: PLATFORM_FEE_PERCENT=10 -> a $60 session shows as $66 to the client.
PLATFORM_FEE_PERCENT=10

# Email via Resend (https://resend.com) — required for notifications and admin replies.
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Add and verify your sending domain (or use the onboarding sandbox sender)
# 3. Create an API key in the dashboard and paste it here
RESEND_API_KEY=
EMAIL_FROM=Bond Therapy <notifications@yourdomain.com>
EMAIL_ADMIN=you@gmail.com
